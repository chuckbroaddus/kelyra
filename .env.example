# Public client config (safe to ship in the app bundle).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local Grok OAuth gateway (npm run ai:dev). No API key.
# Phone / Expo Go: use the computer's LAN URL printed by the gateway.
EXPO_PUBLIC_AI_DEV_URL=http://localhost:8787

# Server only — set these as Supabase Edge Function secrets for a later deploy.
# Never put XAI_API_KEY or OAuth tokens in EXPO_PUBLIC_* or commit them.
# XAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
