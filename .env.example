# Public client config (safe to ship in the app bundle).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — set these as Supabase Edge Function secrets.
# Never put XAI_API_KEY in EXPO_PUBLIC_* or commit it.
# XAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
